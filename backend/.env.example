# API
PORT=3000

# Banco de dados (local)
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=portal_vagas
DB_PORT=5432

# Banco de dados (produção / Supabase): se DATABASE_URL existir, as DB_* acima são ignoradas
# e a conexão usa SSL. Use a string do pooler em modo transaction (porta 6543).
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DB_SSL=true

# Endereço do front em produção, para o CORS (vírgula separa mais de um)
# CORS_ORIGINS=https://portal-vagas.vercel.app

# Limites de requisição a cada 15 minutos (os valores abaixo são os padrões)
# LIMITE_REQUISICOES=1000
# LIMITE_CADASTROS=30
# LIMITE_LOGIN_FALHAS=3

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Chaves do CPF: 64 caracteres hex cada, e DIFERENTES entre si
CPF_CHAVE_CRIPTO=
CPF_CHAVE_HASH=

# Seed do primeiro admin (npm run seed)
ADMIN_NOME=Administrador
ADMIN_SOBRENOME=Sistema
ADMIN_EMAIL=
ADMIN_SENHA=

GITHUB_TOKEN=